# Backend API base URL (Leave blank or specify full URL e.g. https://api.agrisync.in)
VITE_API_URL=https://your-backend-api.com

# Realtime WebSocket / Socket.IO Server URL (Optional if matching VITE_API_URL)
VITE_SOCKET_URL=https://your-backend-api.com

# Public Supabase Client Config (Optional)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

