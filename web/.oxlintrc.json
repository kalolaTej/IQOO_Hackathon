{
  "plugins": ["react", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": "off",
    "react/static-components": "off",
    "no-unused-vars": "off",
    "react/purity": "off",
    "react/set-state-in-effect": "off",
    "react-hooks/exhaustive-deps": "off"
  }
}
