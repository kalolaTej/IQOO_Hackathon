# AgriSync Produce Grading Service — environment variables
#
# Currently the grading service does not require any secrets or
# external configuration.  All grading parameters are defined in
# grading.py as documented constants.
#
# If future integration with the Node.js backend requires shared
# configuration (e.g., service URLs, API keys), add variables here.
#
# NEVER place real secrets in this file — use a local .env instead.

# Optional: override the default uvicorn port
# GRADING_SERVICE_PORT=8001

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
