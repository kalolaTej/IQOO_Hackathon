# ====================================================
# AGRI-SYNC AI DETECTION ENGINE CONFIGURATION TEMPLATE (.env.example)
# ====================================================

# 1. BACKEND API CONNECTION
BACKEND_URL=http://localhost:5000
EDGE_API_KEY=TETRA044_Crystals

# 2. CAMERA FEED SOURCE
# Paste your Android IP Webcam URL (e.g. http://192.168.1.50:8080/video), or 0 for webcam, or test_video/cows.mp4
CAMERA_SOURCE=http://10.10.13.135:8080/video
RTSP_STREAM_URL=http://10.10.13.135:8080/video
CAMERA_ID=cam_01
ZONE_NAME=North_Field

# 3. WOKWI / PHYSICAL ESP32 HARDWARE DETERRENT
ESP32_ENABLED=true
ESP32_MODE=http
ESP32_IP=192.168.1.150
ESP32_PORT=80

# 4. DETECTION PARAMETERS
CONFIDENCE_THRESHOLD=0.35
COOLDOWN_SECONDS=10
TARGET_ANIMALS=cow,goat,pig,sheep,horse,dog,cat,bear,elephant,zebra,giraffe

# 5. DRY RUN MODE
DRY_RUN=false
