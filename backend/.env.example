# Server Configuration
HOST=0.0.0.0
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-domain.com

# Database & Storage (Supabase Cloud PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Market Intelligence (data.gov.in AGMARKNET API)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
AGMARKNET_API_KEY=your_data_gov_in_api_key_here

# Hardware Deterrent & IoT (Optional)
ESP32_IP=192.168.1.150
SIREN_COOLDOWN_SECONDS=30
SIREN_DURATION_MS=5000

# Produce Grading & Python Microservice (Optional)
PYTHON_BIN=python3
GRADING_SERVICE_URL=http://127.0.0.1:8001

# AI Detection Configuration
ANIMAL_CONFIDENCE_THRESHOLD=0.60

